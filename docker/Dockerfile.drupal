# Blog de FakeEnv — Drupal 7.30 sobre PHP 5.6 (desactualizado a propósito).
#
# El core de Drupal < 7.32 es vulnerable a SA-CORE-2014-005 ("Drupalgeddon",
# CVE-2014-3704, inyección SQL). La 7.30 es anterior a PHP 7, de ahí la base
# PHP 5.6. No exponer nunca a Internet.

FROM php:5.6-apache

# Los repos de Debian Stretch están archivados: apuntamos apt a archive.debian.org.
RUN set -eux; \
    sed -ri 's|http://deb.debian.org|http://archive.debian.org|g; \
             s|http://security.debian.org|http://archive.debian.org|g; \
             /-updates/d' /etc/apt/sources.list; \
    apt-get -o Acquire::Check-Valid-Until=false \
            -o Acquire::AllowInsecureRepositories=true update; \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
        default-mysql-client libpng-dev libjpeg-dev; \
    rm -rf /var/lib/apt/lists/*

# Extensiones PHP que necesita Drupal 7 (gd para imágenes, pdo_mysql para la BD).
RUN docker-php-ext-configure gd --with-png-dir=/usr --with-jpeg-dir=/usr \
 && docker-php-ext-install -j"$(nproc)" gd pdo_mysql mysqli

# Drupal 7 requiere desactivar la conversión HTTP de mbstring. Apuntamos también
# sendmail a /bin/true para que mail() de PHP no falle (no hay MTA en el lab).
RUN { \
        echo 'mbstring.http_input = pass'; \
        echo 'mbstring.http_output = pass'; \
        echo 'mbstring.encoding_translation = Off'; \
        echo 'mbstring.func_overload = 0'; \
        echo 'sendmail_path = /bin/true'; \
    } > /usr/local/etc/php/conf.d/drupal.ini

# URLs limpias (mod_rewrite + AllowOverride para los .htaccess de Drupal).
RUN a2enmod rewrite \
 && printf '<Directory /var/www/html>\n    AllowOverride All\n</Directory>\n' \
        > /etc/apache2/conf-available/drupal.conf \
 && a2enconf drupal

# Código fuente de Drupal 7.30.
RUN set -eux; \
    php -r "copy('https://ftp.drupal.org/files/projects/drupal-7.30.tar.gz', '/tmp/drupal.tar.gz');"; \
    tar -xz --strip-components=1 -C /var/www/html -f /tmp/drupal.tar.gz; \
    rm /tmp/drupal.tar.gz; \
    chown -R www-data:www-data /var/www/html
