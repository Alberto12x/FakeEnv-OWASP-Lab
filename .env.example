# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_CONFIG=development        # development | production
FLASK_DEBUG=1

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=mysql+pymysql://fakenv_user:fakenv_pass@localhost:3306/fakenv_db
